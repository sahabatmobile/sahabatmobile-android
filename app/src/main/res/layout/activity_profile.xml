<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgLight"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/textOnBrand" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_settings_title"
                android:textColor="@color/textOnBrand"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_settings_subtitle"
                android:textColor="@color/textOnBrandMuted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs: Profil | Pengaturan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_profile"
            android:textColor="@color/primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_settings"
            android:textColor="@color/textSecondary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabTasks"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_tasks"
            android:textColor="@color/textSecondary"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ TAB: PROFIL ============ -->
        <ScrollView
            android:id="@+id/scrollProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profil Pengguna (Asisten Pribadi)"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Data ini dibaca AI untuk saran kesehatan, kegiatan, dan pekerjaan yang sesuai dengan Anda."
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tanggal Lahir"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtBirthDate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Belum diisi"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnPickDate"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/pick_birth_date"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Umur: -"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pekerjaan"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtJob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Mis. Karyawan, Wiraswasta, Ibu Rumah Tangga"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hobi &amp; Kegemaran"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtHobby"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Mis. membaca, berkebun, olahraga, masak"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Kesehatan / Keluhan"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtHealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Mis. hipertensi, diabetes, asma, alergi..."
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tujuan Penggunaan Aplikasi"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Mis. asisten pribadi harian, kesehatan, produktivitas"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Simpan Profil"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/errorBg"
                    android:text="Hapus Profil"
                    android:textColor="@color/errorText"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ TAB: PENGATURAN ============ -->
        <ScrollView
            android:id="@+id/scrollSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API KEY"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edtApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="@string/api_key_hint"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtKeyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/key_not_set"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSaveKey"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/save_api_key"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="MODEL AI"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/model_one_place_hint"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtCurrentModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="@string/model_empty"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnPickModel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/change_model"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="TAMPILAN"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/toggle_width"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_width_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="WHATSAPP AI"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWaAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/wa_auto_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_auto_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWaTranslate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/wa_translate_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_translate_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnEnableWaNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/wa_enable_notifications"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wa_enable_notifications_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <!-- WhatsApp Number Mapping -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/wa_number_mapping_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_number_mapping_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wa_number_personal_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerWaPersonal"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:padding="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wa_number_business_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerWaBusiness"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:padding="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wa_number_default_label"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerWaDefault"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wa_number_default_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <!-- Product Catalog -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/wa_product_catalog_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_product_catalog_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/edtProductInfo"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:gravity="top|start"
                    android:hint="@string/wa_product_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveProduct"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/wa_product_save"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <!-- FAQ / Q&A -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/wa_faq_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_faq_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/edtFaqInfo"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:gravity="top|start"
                    android:hint="@string/wa_faq_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveFaq"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/wa_faq_save"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <!-- Ringkasan Harian -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/daily_summary_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDailySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/daily_summary_toggle"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_summary_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnPickSummaryTime"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surfaceMuted"
                    android:text="@string/daily_summary_time"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTestSummary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primaryTint"
                    android:text="@string/daily_summary_test"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTestWeekly"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primaryTint"
                    android:text="@string/weekly_summary_test"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <!-- Pesan Terjadwal WA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/wa_sched_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_sched_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnSchedAdd"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/wa_sched_add"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSchedManage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surfaceMuted"
                    android:text="@string/wa_sched_manage"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <!-- Persona per Kontak -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/wa_contact_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wa_contact_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <Button
                    android:id="@+id/btnContactAdd"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/wa_contact_add"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnContactManage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surfaceMuted"
                    android:text="@string/wa_contact_manage"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <!-- Suara / TTS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/tts_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tts_toggle"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <!-- Mode Fokus -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/focus_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/focus_toggle"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/edtFocusReply"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:gravity="top|start"
                    android:hint="@string/focus_reply_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="12dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFocusStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12.5sp" />

                <!-- Catatan Keuangan -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/fin_title"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fin_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp" />

                <Spinner
                    android:id="@+id/spinnerFinType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected" />

                <EditText
                    android:id="@+id/edtFinAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:hint="@string/fin_amount_hint"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edtFinDesc"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:gravity="top|start"
                    android:hint="@string/fin_desc_hint"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFinAdd"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/fin_add"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFinTotals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/fin_totals_none"
                    android:textColor="@color/textPrimary"
                    android:textSize="12.5sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="DATA"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:backgroundTint="@color/errorBg"
                    android:text="@string/clear_history"
                    android:textColor="@color/errorText"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBackup"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surfaceMuted"
                    android:text="@string/backup_export"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRestore"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surfaceMuted"
                    android:text="@string/backup_import"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/updater_check"
                    android:textColor="@color/textOnBrand"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ TAB: TUGAS & PENGINGAT ============ -->
        <ScrollView
            android:id="@+id/scrollTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tasks_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnAddTask"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/add_task"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/taskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/txtTaskEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/tasks_empty"
                    android:textColor="@color/textSecondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="CATATAN KESEHATAN"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/health_log_desc"
                    android:textColor="@color/textSecondary"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/healthList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtHealthEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/health_empty"
                    android:textColor="@color/textSecondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
