<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_call_title"
        android:textColor="@color/textPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_call_hint"
        android:textColor="@color/textSecondary"
        android:textSize="12.5sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:padding="14dp"
        android:text="@string/voice_call_status_idle"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:layout_marginBottom="24dp" />

    <ImageButton
        android:id="@+id/btnVoiceCallMic"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_icon_button"
        android:src="@drawable/ic_mic"
        android:contentDescription="@string/voice_call_title"
        android:scaleType="centerInside"
        android:padding="32dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnEndCall"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input"
        android:text="@string/voice_call_end"
        android:textColor="@color/errorText"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnVoiceSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:text="@string/voice_call_settings"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />
</LinearLayout>
