<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgLight">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/rootContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_app"
            android:orientation="vertical">

            <!-- ============ HEADER ============ -->
            <LinearLayout
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/header_padding_h"
                android:paddingTop="@dimen/header_padding_v"
                android:paddingEnd="@dimen/header_padding_h"
                android:paddingBottom="@dimen/header_padding_v">

                <TextView
                    android:id="@+id/btnSidebar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_history"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="@color/textOnBrand"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_premium_circle"
                    android:contentDescription="@string/app_name"
                    android:padding="7dp"
                    android:src="@drawable/ic_premium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtHeaderEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/brand_small"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.Sahabat.Eyebrow"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtHeaderGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:maxLines="1"
                        android:text="@string/greeting_generic"
                        android:textColor="@color/textOnBrand"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtPersona"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/persona_general"
                        android:textColor="@color/textOnBrandMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtKeyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_gold"
                    android:maxWidth="90dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/TextAppearance.Sahabat.Badge"
                    android:textColor="@color/primaryDeep"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_profile_circle"
                    android:contentDescription="@string/profile"
                    android:padding="8dp"
                    android:src="@drawable/ic_profile" />
            </LinearLayout>

            <!-- ============ MESSAGES ============ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/scrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bubbleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/screen_padding"
                        android:paddingTop="14dp"
                        android:paddingEnd="@dimen/screen_padding"
                        android:paddingBottom="18dp" />
                </ScrollView>

                <!-- Empty state -->
                <ScrollView
                    android:id="@+id/welcomeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/welcomeView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="26dp"
                        android:paddingTop="30dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="30dp">

                        <ImageView
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_premium_circle"
                            android:contentDescription="@string/app_name"
                            android:elevation="6dp"
                            android:padding="13dp"
                            android:src="@drawable/ic_premium" />

                        <TextView
                            android:id="@+id/txtWelcomeHero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:text="@string/welcome_question"
                            android:textAppearance="@style/TextAppearance.Sahabat.Hero" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/gold" />

                        <TextView
                            android:id="@+id/txtWelcomeSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="@string/welcome_subtitle"
                            android:textAppearance="@style/TextAppearance.Sahabat.Body" />

                        <!-- Dashboard Dinamis (pengguna aktif) -->
                        <LinearLayout
                            android:id="@+id/dashboardContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:text="@string/persona_section"
                            android:textAppearance="@style/TextAppearance.Sahabat.Section" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/personaChips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/suggestionContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip1"
                                style="@style/Widget.Sahabat.Chip.Suggestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/sugg_1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip2"
                                style="@style/Widget.Sahabat.Chip.Suggestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/sugg_2" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip3"
                                style="@style/Widget.Sahabat.Chip.Suggestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/sugg_3" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chip4"
                                style="@style/Widget.Sahabat.Chip.Suggestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/sugg_4" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/promptSuggestions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:orientation="vertical" />

                        <!-- Tugas & pengingat hari ini -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="@string/today_tasks_section"
                            android:textAppearance="@style/TextAppearance.Sahabat.Section" />

                        <LinearLayout
                            android:id="@+id/taskTodayContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlanDay"
                            style="@style/Widget.Sahabat.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/plan_day_button" />

                        <!-- Contoh perintah -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="@string/example_section"
                            android:textAppearance="@style/TextAppearance.Sahabat.Section" />

                        <LinearLayout
                            android:id="@+id/exampleContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHealthCheck"
                            style="@style/Widget.Sahabat.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/health_check_btn" />
                    </LinearLayout>
                </ScrollView>

                <!-- Kontrol cadangan saat topbar disembunyikan -->
                <LinearLayout
                    android:id="@+id/topbarFloatControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:elevation="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnFloatSidebar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_profile_circle"
                        android:contentDescription="@string/menu_history"
                        android:gravity="center"
                        android:text="☰"
                        android:textColor="@color/primaryDeep"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnFloatShowTopbar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_profile_circle"
                        android:contentDescription="@string/show_topbar"
                        android:gravity="center"
                        android:text="▼"
                        android:textColor="@color/primaryDeep"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- ============ COMPOSER ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:elevation="16dp"
                android:orientation="vertical">

                <!-- Active model pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/modelPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="@string/loading_models"
                        android:textColor="@color/textSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Attachment preview -->
                <LinearLayout
                    android:id="@+id/attachPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/previewImage"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_preview"
                        android:contentDescription="@string/image_bubble_desc"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/image_added"
                        android:textAppearance="@style/TextAppearance.Sahabat.Body" />

                    <ImageButton
                        android:id="@+id/btnRemoveImage"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/remove_image"
                        android:padding="9dp"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <!-- Recording bar -->
                <LinearLayout
                    android:id="@+id/recordBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_record_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/recordDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_record_dot" />

                    <TextView
                        android:id="@+id/recordTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/recording"
                        android:textColor="@color/errorText"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/recordLevel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progressTint="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="14dp">

                    <ImageButton
                        android:id="@+id/btnAttach"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/attach_image"
                        android:elevation="2dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_image" />

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/chat_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="5"
                        android:minHeight="52dp"
                        android:paddingStart="18dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnMic"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/send_voice"
                        android:elevation="2dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_mic" />

                    <ImageButton
                        android:id="@+id/btnSend"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_send"
                        android:contentDescription="@string/send"
                        android:elevation="6dp"
                        android:padding="15dp"
                        android:src="@drawable/ic_send" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ ONBOARDING OVERLAY ============ -->
        <ScrollView
            android:id="@+id/onboardingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_onboarding"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="26dp">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="36dp" />

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_premium_circle"
                    android:contentDescription="@string/app_name"
                    android:elevation="8dp"
                    android:padding="20dp"
                    android:src="@drawable/ic_premium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/brand_small"
                    android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.Sahabat.Eyebrow" />

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/greeting_generic"
                    android:textColor="@color/textOnBrand"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtHeaderBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/onboarding_tagline"
                    android:textColor="@color/textOnBrandMuted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_onboarding_card"
                    android:elevation="12dp"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/txtSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/onboarding_steps"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="@string/name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:minHeight="54dp"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/textPrimary"
                        android:textColorHint="@color/textSecondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLanjut"
                        style="@style/Widget.Sahabat.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/lanjut" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOnboardKey"
                        style="@style/Widget.Sahabat.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/onboard_key_btn" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOnboardWeb"
                        style="@style/Widget.Sahabat.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/onboard_web_btn" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ DRAWER ============ -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_sheet"
        android:elevation="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_small"
                android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.Sahabat.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:text="@string/drawer_title"
                android:textColor="@color/textOnBrand"
                android:textSize="22sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewChat"
            style="@style/Widget.Sahabat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/new_chat" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="20dp" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrawerPapan"
            style="@style/Widget.Sahabat.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/papan_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrawerTasks"
